{
  "name": "oceanic",
  "palette": {
    "--sidebar-bg": "#0B1C26",
    "--sidebar-fg": "#A8DADC",
    "--sidebar-button-bg": "#12303D",
    "--sidebar-button-fg": "#CDEFF2",
    "--sidebar-button-border": "#1D5B73",
    "--toolbar-bg": "#0F2733",
    "--toolbar-fg": "#A8DADC",
    "--editor-bg": "#0A1A22",
    "--editor-fg": "#E0FBFC",
    "--panel-bg": "#0B1C26",

    "--terminal-bg": "#0A1A22",
    "--terminal-fg": "#A8DADC",
    "--terminal-input-bg": "#12303D",
    "--terminal-input-fg": "#CDEFF2",
    "--terminal-prompt-fg": "#4DD0E1",
    "--terminal-button-bg": "#1D5B73",
    "--terminal-button-hover-bg": "#267A99",
    "--terminal-button-fg": "#E0FBFC",
    "--terminal-button-border": "#4DD0E1",
    "--terminal-border": "#1D5B73"
  },
  "typography": {
    "fontFamily": "JetBrains Mono",
    "fontSize": 14
  },
  "monaco": {
    "base": "vs-dark",
    "rules": [
      { "token": "comment", "foreground": "#4DD0E155" },
      { "token": "keyword", "foreground": "#4DD0E1" },
      { "token": "string", "foreground": "#99F6E4" },
      { "token": "number", "foreground": "#FFB86C" },
      { "token": "type", "foreground": "#82AAFF" },
      { "token": "function", "foreground": "#56CCF2" },
      { "token": "variable", "foreground": "#E0FBFC" },
      { "token": "delimiter", "foreground": "#A8DADC" }
    ],
    "colors": {
      "editor.background": "#0A1A22",
      "editor.foreground": "#E0FBFC",
      "editorCursor.foreground": "#4DD0E1",
      "editor.lineHighlightBackground": "#12303D55",
      "editor.selectionBackground": "#1D5B7344",
      "editor.inactiveSelectionBackground": "#1D5B7322",
      "editorLineNumber.foreground": "#3A5A68",
      "editorActiveLineNumber.foreground": "#4DD0E1",
      "editorIndentGuide.background": "#1D3A47",
      "editorIndentGuide.activeBackground": "#4DD0E1"
    }
  }
}
