{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "my-code-editor",
  "version": "0.2.0",
  "identifier": "com.caracore.xperience.my.code.editor",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "my-code-editor",
        "width": 1220,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "deb", "rpm", "appimage"],
    "publisher": "Caracore Xperience",
    "copyright": "© 2026 Caracore Xperience",
    "category": "DeveloperTool",
    "shortDescription": "A lightweight Tauri + React + CodeMirror 6 IDE.",
    "longDescription": "my-code-editor is a fast, hackable code editor built with Tauri 2, React 19, CodeMirror 6 and xterm.js. It supports themes, plugins, LSP and embedded terminals.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": true,
        "languages": ["English", "French"]
      },
      "wix": {
        "language": ["en-US", "fr-FR"]
      }
    },
    "linux": {
      "deb": {
        "depends": []
      },
      "rpm": {
        "depends": []
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
