{
  "name": "joe-rose",
  "palette": {
    "--sidebar-bg": "#F2C9C2",
    "--sidebar-fg": "#2B2B2B",
    "--sidebar-button-bg": "#E8B7B7",
    "--sidebar-button-fg": "#2B2B2B",
    "--sidebar-button-border": "#CFA4A4",

    "--toolbar-bg": "#E8B7B7",
    "--toolbar-fg": "#2B2B2B",

    "--editor-bg": "#F7E4E1",
    "--editor-fg": "#2B2B2B",

    "--panel-bg": "#F7E4E1",

    "--terminal-bg": "#3A2A2A",
    "--terminal-fg": "#FF7A7A",
    "--terminal-input-bg": "#4A3A3A",
    "--terminal-input-fg": "#FF7A7A",
    "--terminal-prompt-fg": "#FF7A7A",
    "--terminal-button-bg": "#5A3E3E",
    "--terminal-button-hover-bg": "#6A4A4A",
    "--terminal-button-fg": "#FF7A7A",
    "--terminal-button-border": "#FF7A7A",
    "--terminal-border": "#6A4A4A"
  },

  "typography": {
    "fontFamily": "JetBrains Mono",
    "fontSize": 14
  },

  "monaco": {
    "base": "vs-dark",
    "rules": [
      { "token": "comment", "foreground": "#FF7A7A55" },
      { "token": "keyword", "foreground": "#FF7A7A" },
      { "token": "string", "foreground": "#FFB7B7" },
      { "token": "number", "foreground": "#FF9A6C" },
      { "token": "type", "foreground": "#E8B7E8" },
      { "token": "function", "foreground": "#FF8A8A" },
      { "token": "variable", "foreground": "#F7E4E1" },
      { "token": "delimiter", "foreground": "#E8B7B7" }
    ],
    "colors": {
      "editor.background": "#F7E4E1",
      "editor.foreground": "#2B2B2B",
      "editorCursor.foreground": "#FF7A7A",
      "editor.lineHighlightBackground": "#E8B7B755",
      "editor.selectionBackground": "#CFA4A444",
      "editor.inactiveSelectionBackground": "#CFA4A422",
      "editorLineNumber.foreground": "#A88F8F",
      "editorActiveLineNumber.foreground": "#FF7A7A",
      "editorIndentGuide.background": "#D8B8B8",
      "editorIndentGuide.activeBackground": "#FF7A7A"
    }
  }
}
