{
  "inherit": false,
  "name": "joe-synthwave-neon",
  "palette": {
    "--sidebar-bg": "#1A0033",
    "--sidebar-fg": "#FF6EC7",
    "--sidebar-button-bg": "#2A0050",
    "--sidebar-button-fg": "#FF9BF2",
    "--sidebar-button-border": "#FF00C8",

    "--toolbar-bg": "#240040",
    "--toolbar-fg": "#FF6EC7",
    "--toolbar-button-bg": "#2A0050",
    "--toolbar-button-hover": "#3A0070",
    "--toolbar-button-fg": "#FF9BF2",
    "--toolbar-button-border": "#FF00C8",

    "--editor-bg": "#0D001A",
    "--editor-fg": "#F8EFFF",

    "--panel-bg": "#140026",

    "--terminal-bg": "#0A0018",
    "--terminal-fg": "#00F0FF",
    "--terminal-input-bg": "#1A0033",
    "--terminal-input-fg": "#00F0FF",
    "--terminal-prompt-fg": "#FF00C8",
    "--terminal-button-bg": "#2A0050",
    "--terminal-button-hover-bg": "#3A0070",
    "--terminal-button-fg": "#00F0FF",
    "--terminal-button-border": "#FF00C8",
    "--terminal-border": "#3A0070"
  },

  "typography": {
    "fontFamily": "JetBrains Mono",
    "fontSize": 14
  },

  "monaco": {
    "base": "vs-dark",
    "rules": [
      { "token": "comment", "foreground": "#FF00C855" },
      { "token": "keyword", "foreground": "#FF00C8" },
      { "token": "string", "foreground": "#00F0FF" },
      { "token": "number", "foreground": "#FF6EC7" },
      { "token": "type", "foreground": "#9D4BFF" },
      { "token": "function", "foreground": "#FF9BF2" },
      { "token": "variable", "foreground": "#F8EFFF" },
      { "token": "delimiter", "foreground": "#FF6EC7" }
    ],
    "colors": {
      "editor.background": "#0D001A",
      "editor.foreground": "#F8EFFF",
      "editorCursor.foreground": "#00F0FF",
      "editor.lineHighlightBackground": "#2A005055",
      "editor.selectionBackground": "#FF00C844",
      "editor.inactiveSelectionBackground": "#FF00C822",
      "editorLineNumber.foreground": "#6A3A99",
      "editorActiveLineNumber.foreground": "#FF00C8",
      "editorIndentGuide.background": "#3A0070",
      "editorIndentGuide.activeBackground": "#FF00C8",

      "editorWidget.background": "#140026",
      "editorWidget.border": "#FF00C8",

      "editorSuggestWidget.background": "#140026",
      "editorSuggestWidget.border": "#FF00C8",
      "editorSuggestWidget.foreground": "#FF9BF2",
      "editorSuggestWidget.selectedBackground": "#2A0050",
      "editorSuggestWidget.highlightForeground": "#FF00C8",

      "editorHoverWidget.background": "#140026",
      "editorHoverWidget.border": "#FF00C8",

      "editorMarkerNavigation.background": "#140026",
      "editorMarkerNavigationError.background": "#FF00C8",
      "editorMarkerNavigationWarning.background": "#FF6EC7",

      "input.background": "#1A0033",
      "input.foreground": "#FF9BF2",
      "input.border": "#FF00C8"
    }
  }
}
